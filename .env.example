# Copy this file to `.env` and adjust values as needed.
# Docker Compose reads `.env` automatically for variable substitution.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,www.buyerkraze.com

# --- Database (SQLite by default) ---
# To use PostgreSQL instead, set DB_ENGINE and uncomment the `db`
# service in docker-compose.yml:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=buyerkraze
# DB_USER=buyerkraze
# DB_PASSWORD=buyerkraze
# DB_HOST=db
# DB_PORT=5432
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# --- Optional: auto-create superuser on first start ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@buyerkraze.com
DJANGO_SUPERUSER_PASSWORD=admin
