# Copy to `.env` (untracked) and fill in. Loaded by docker-compose (env_file).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=buyerkraze.com,www.buyerkraze.com
CSRF_TRUSTED_ORIGINS=https://buyerkraze.com,https://www.buyerkraze.com

# --- External SQL Server ---
DB_ENGINE=mssql
DB_NAME=buyerkraze
DB_USER=
DB_PASSWORD=
DB_HOST=host.docker.internal
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Optional: auto-create superuser on first start ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- SEO ---
SITE_URL=https://buyerkraze.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Issue Ticca ---
ISSUE_TICCA_ENABLED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ISSUE_TICCA_ACCESS_KEY=change-me
ISSUE_TICCA_SLOW_RESPONSE_THRESHOLD=10.0
ISSUE_TICCA_AUTO_RESOLVE_ON_SUCCESS=true
ISSUE_TICCA_TRACK_HOURLY_USERS=true
ISSUE_TICCA_HOURLY_STATS_RETENTION_DAYS=7

# --- Internationalization ---
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
USE_I18N=true
USE_TZ=true

# --- Production behind a reverse proxy (Contabo) ---
# Set true only once HTTPS works and the proxy sends X-Forwarded-Proto.
SECURE_SSL_REDIRECT=false
# e.g. 31536000 once you are sure HTTPS is permanent
SECURE_HSTS_SECONDS=0
