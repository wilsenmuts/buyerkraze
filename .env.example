# Copy to `.env` (untracked) and fill in. Loaded by docker-compose (env_file).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=buyerkraze.com,www.buyerkraze.com
CSRF_TRUSTED_ORIGINS=https://buyerkraze.com,https://www.buyerkraze.com

# --- External SQL Server ---
DB_ENGINE=mssql
DB_NAME=buyerkraze
DB_USER=
DB_PASSWORD=
DB_HOST=host.docker.internal
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Optional: auto-create superuser on first start ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
